<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseUTF8Encoding>true</UseUTF8Encoding>
    <Version>1.0.0</Version>
    <RootNamespace>ET</RootNamespace>
    <LangVersion>default</LangVersion>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\</RepoRoot>
  </PropertyGroup>

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>$(RepoRoot)Bin</OutputPath>
    <NoWarn>1701;1702;NU1903</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>$(RepoRoot)Bin</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- EPPlus for Excel operations -->
    <PackageReference Include="EPPlus" Version="8.0.8" />
    <!-- 显式升级传递依赖，修复 CVE-2026-70162 (GHSA-2fmv-rv2c-59x7)：Pkcs <= 9.0.20 受影响，9.0.21 已修复 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude test files from main project -->
    <Compile Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

</Project>
